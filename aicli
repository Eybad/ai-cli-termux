#!/data/data/com.termux/files/usr/bin/bash

set -euo pipefail

AICLI_VERSION="1.3.0"
# Ownership marker for $PREFIX/bin/aicli wrapper to prevent overwriting third-party binaries.
AICLI_MARK="aicli-managed: ai-cli-termux"
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="${AI_CLI_TERMUX_DIR:-$SCRIPT_DIR}"
INSTALL_SH="$REPO_DIR/install.sh"
VERIFY_SH="$REPO_DIR/verify.sh"
REGISTRY_DIR="$REPO_DIR/registry"

SUBCOMMANDS="install update remove verify list help doctor completion self-install self-update"

MUTED=''; GREEN=''; RED=''; ORANGE=''; NC=''

info() { printf '%sINFO%s: %s\n' "$GREEN" "$NC" "$*" >&2; }
warn() { printf '%sWARN%s: %s\n' "$ORANGE" "$NC" "$*" >&2; }
err()  { printf '%sERROR%s: %s\n' "$RED" "$NC" "$*" >&2; }

conf_get() {
  local file="$1" key="$2"
  awk -F= -v k="$key" '
    $1 == k {
      v = $0; sub(/^[^=]*=/, "", v)
      sub(/#.*$/, "", v)
      gsub(/[ \t]+$/, "", v)
      gsub(/^[ \t]+/, "", v)
      gsub(/^"|"$/, "", v)
      gsub(/[\001-\037\177]/, " ", v)
      gsub(/  +/, " ", v)
      print v
      exit
    }' "$file" | sed 's/ $//'
}

list_registry() {
  local f name
  [[ -d "$REGISTRY_DIR" ]] || return 0
  for f in "$REGISTRY_DIR"/*.conf; do
    [[ -f "$f" ]] || continue
    name=$(basename "$f" .conf)
    [[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]] || continue
    printf '%s\n' "$name"
  done
}

validate_tool() {
  local t="$1"
  [[ "$t" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]] || {
    err "Invalid tool name: '$t'"
    exit 2
  }
  [[ -f "$REGISTRY_DIR/$t.conf" ]] || {
    err "Unknown tool: '$t'"
    err "Available: $(tools_spaced)"
    exit 2
  }
}

manifest_get() {
  local key="$1" mf="$2"
  [[ -f "$mf" ]] || return 0
  awk -F= -v k="$key" '{ sub(/\r$/, "") } $1==k { sub(/^[^=]*=/,""); print; exit }' "$mf"
}

check_repo() {
  [[ -f "$INSTALL_SH" && -f "$VERIFY_SH" && -d "$REGISTRY_DIR" ]] || {
    err "No se encuentra el repositorio ai-cli-termux en: $REPO_DIR"
    err "Opciones: corré aicli desde el clon del repo, definí AI_CLI_TERMUX_DIR,"
    err "o ejecutá 'aicli self-install' desde el clon (instala el wrapper)."
    exit 1
  }
}

usage_short() {
  cat <<EOF
aicli — AI CLI manager for Termux (install, update, audit; no PRoot)

Usage: aicli <subcommand> [options]
  aicli list [--offline] [--json] [<tool>]
  aicli install <tool> [-v X.Y.Z | --sha256 <hash> | --require-attestation]
  aicli update <tool> | aicli update --all | remove <tool> | verify <tool>
  aicli help [<subcommand>|<tool>] | doctor | completion <bash|zsh|fish>
  aicli self-install | self-update | --version

Examples:
  aicli list
  aicli install opencode
  aicli update agy

Run 'aicli help' for full documentation.
EOF
}

usage() {
  local tools
  tools=$(list_registry)
  cat <<EOF
aicli $AICLI_VERSION — AI CLI manager for Termux (glibc overlay, no PRoot)

Usage:
  aicli [--version] [-h|--help] [--no-color]
  aicli <subcommand> [-h|--help] [options]

Subcommands:
  install <tool> [flags]    Install an AI CLI. Flags: -v X.Y.Z (version),
                            --sha256 <hash>, --require-attestation
                            (see 'aicli install --help')
  update <tool>             Update to the latest available version
  update --all              Update all installed CLIs sequentially (a failure does
                            not abort the rest; exit 1 if any tool fails)
  remove <tool>             Uninstall completely
  verify <tool>             Audit installation integrity (10 steps)
  list [options]            List CLIs: status, installed version, and
                            available updates
                            (--offline: no network · --json: machine output ·
                             [<tool>]: filter by tool)
  help [<sub>|<tool>]       General help, subcommand help, or tool details
  doctor                    Environment diagnostics (repo, wrapper, dependencies)
  completion <shell>        Generate shell completions for bash|zsh|fish (stdout)
  self-install              Install/update aicli wrapper in \$PREFIX/bin
  self-update               Update already installed wrapper (must exist)

Available tools:
$(print_tools "$tools")

CLIs are executed via their own commands (e.g., opencode run, codex exec).
aicli only manages them without duplicating tool commands. For CLI help,
consult <tool> --help.

Examples:
  aicli install opencode
  aicli update agy
  aicli list --offline
  aicli verify codex
EOF
}

print_tools() {
  local t f desc
  for t in $1; do
    f="$REGISTRY_DIR/$t.conf"
    desc=$(conf_get "$f" DESCRIPTION)
    if [[ -n "$desc" ]]; then
      printf '  %-14s %s\n' "$t" "$desc"
    else
      printf '  %-14s\n' "$t"
    fi
  done
}

help_sub() {
  case "$1" in
    install)
      cat <<'EOF'
aicli install <tool> [flags]

Installs an AI CLI on Termux (glibc overlay, no PRoot). Version and checksum
are resolved automatically from upstream sources (fail-closed: no installation
without verified hash).

Flags:
  -v, --version <X.Y.Z>      Install a specific version
  --sha256 <hash>            Pin tarball checksum explicitly
  --require-attestation      Abort if GitHub release attestation cannot be
                             verified (tools with ATTEST_PREDICATE only)

Examples:
  aicli install opencode
  aicli install codex -v 0.146.0+android1
EOF
      ;;
    update)
      cat <<'EOF'
aicli update <tool> | aicli update --all

Updates an AI CLI to the latest available version within the installer's
fail-closed verification pipeline (checksum + attestation), even for tools
with built-in self-updaters (blocked by the wrapper).

  aicli update <tool>     Updates a single CLI
  aicli update --all      Sequentially updates all installed CLIs.
                          A failure on one tool does not stop the rest; final
                          summary and exit code reflect errors (0 OK, 1 failed).
                          Uninstalled CLIs are skipped.

Examples:
  aicli update agy
  aicli update --all
EOF
      ;;
    remove)
      cat <<'EOF'
aicli remove <tool>

Uninstalls an AI CLI completely: binary, wrapper, aliases, registered shims,
and integrity manifest.

Examples:
  aicli remove opencode
EOF
      ;;
    verify)
      cat <<'EOF'
aicli verify <tool>

Audits installation integrity in 10 steps: manifest, binary, interpreter/rpath,
post-patchelf checksums, consistency with sha256.txt, attestation, wrapper,
glibc environment, and runtime execution.
Exit code 1 on any failure.

Examples:
  aicli verify codex
EOF
      ;;
    list)
      cat <<'EOF'
aicli list [--offline] [--json] [<tool>]

Lists registry CLIs with local status (installed/not installed, manifest
version) and, if network is available, update status (UPDATE column:
yes | no | n/a). Network errors degrade gracefully to n/a without failing.

Flags:
  --offline   Do not query network (skips update check)
  --json      Machine-readable output (JSON array of tools) for scripts/agents
  <tool>      Filter by specific tool name

Exit 0 always (informational).
EOF
      ;;
    help)
      cat <<'EOF'
aicli help [<subcommand>|<tool>]

Without arguments: complete help reference. With a subcommand: help for that
command (e.g., aicli help list). With a tool name: details for that CLI
(description, distribution, and management commands; e.g., aicli help codex).
EOF
      ;;
    doctor)
      cat <<'EOF'
aicli doctor

Diagnoses the aicli environment: resolvable repository, wrapper installed
with ownership mark, supported architecture, installer dependencies
(curl, jq, tar, awk, sha256sum), and glibc dynamic loader. Suggests the next
action when something is missing (e.g., aicli self-install). Exit 1 on failure.
EOF
      ;;
    completion)
      cat <<'EOF'
aicli completion <bash|zsh|fish>

Generates shell completion script for the specified shell and prints to stdout.
Installation (bash, requires pkg install bash-completion):

  aicli completion bash > ~/.bash_completion.d/aicli

zsh (on fpath):
  aicli completion zsh > ~/.zfunc/_aicli

fish:
  aicli completion fish > ~/.config/fish/completions/aicli.fish
EOF
      ;;
    self-install)
      cat <<'EOF'
aicli self-install

Installs the aicli wrapper in $PREFIX/bin (embeds repository path and delegates
to the actual aicli script). If the wrapper already exists with ownership mark
('$AICLI_MARK'), it is rewritten; if a foreign binary exists, it fails safely.
Run from repository clone initially:

  bash aicli self-install

Afterwards, aicli is available globally from any directory.
EOF
      ;;
    self-update)
      cat <<'EOF'
aicli self-update

Updates an already installed aicli wrapper (must exist and carry ownership mark).
Fails and suggests 'aicli self-install' if not installed.
Useful after moving the repository or updating via git pull.
EOF
      ;;
    *)
      err "No help available for subcommand '$1'."
      return 2
      ;;
  esac
}

help_tool() {
  local t="$1" f app display desc source repo
  validate_tool "$t"
  f="$REGISTRY_DIR/$t.conf"
  app=$(conf_get "$f" APP_NAME)
  display=$(conf_get "$f" DISPLAY_NAME)
  desc=$(conf_get "$f" DESCRIPTION)
  source=$(conf_get "$f" RELEASE_SOURCE)
  repo=$(conf_get "$f" REPO)

  printf '%s%s%s (%s)\n' "$GREEN" "$display" "$NC" "$t"
  [[ -n "$desc" ]] && printf '  %s\n' "$desc"
  case "$source" in
    github)        printf '  Distribution: GitHub Releases (%s)\n' "${repo:--}" ;;
    manifest_json) printf '  Distribution: remote vendor JSON manifest\n' ;;
    url_template)  printf '  Distribution: CDN with versioned URL (manual pin in sha256.txt)\n' ;;
    *)             printf '  Distribution: %s\n' "${source:--}" ;;
  esac
  cat <<EOF

  Install:   aicli install $t
  Update:    aicli update $t
  Uninstall: aicli remove $t
  Audit:     aicli verify $t
  Tool help: $t --help
EOF
}

cmd_help() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then usage; return 0; fi
  case "$target" in
    -h|--help) usage; return 0 ;;
    install|update|remove|verify|list|help|doctor|completion|self-install|self-update)
      help_sub "$target"
      return 0 ;;
  esac
  if [[ -f "$REGISTRY_DIR/$target.conf" ]]; then
    help_tool "$target"
    return 0
  fi
  err "No help available for '$target' (not a subcommand or registered tool)."
  err "Subcomandos: $SUBCOMMANDS"
  err "Tools: $(tools_spaced)"
  return 2
}

RESOLVE_CACHE_TTL=300
RESOLVE_CACHE_DIR=""

_cache_is_valid() {
  local cache_file="$1"
  test -f "$cache_file" || return 1
  test -L "$cache_file" && return 1
  local expiry now_ts
  expiry=$(awk 'NR==1{print; exit}' "$cache_file" 2>/dev/null) || return 1
  case "$expiry" in
    ''|*[!0-9]*) return 1 ;;
  esac
  now_ts=$(date +%s)
  test "$now_ts" -lt "$expiry"
}

_cache_get() {
  local cache_file="$1"
  test -f "$cache_file" || return 1
  test -L "$cache_file" && return 1
  awk 'NR==2{print; exit}' "$cache_file" 2>/dev/null
}

_cache_set() {
  local cache_file="$1" value="$2"
  test -L "$cache_file" && return 1
  mkdir -p "$(dirname "$cache_file")"
  local now_ts expiry
  now_ts=$(date +%s)
  expiry=$((now_ts + RESOLVE_CACHE_TTL))
  printf '%s\n%s\n' "$expiry" "$value" > "$cache_file"
}

_cleanup_resolve_cache() {
  test -d "$RESOLVE_CACHE_DIR" || return 0
  local f
  for f in "$RESOLVE_CACHE_DIR"/*.latest; do
    test -f "$f" || continue
    if test -L "$f" || ! _cache_is_valid "$f"; then
      rm -f "$f"
    fi
  done
}

resolve_all_latest() {
  local -n _tools_ref=$1

  if test -z "$RESOLVE_CACHE_DIR" || ! test -d "$RESOLVE_CACHE_DIR"; then
    RESOLVE_CACHE_DIR="${TMPDIR:-$PREFIX/tmp}/aicli_resolve"
    mkdir -p "$RESOLVE_CACHE_DIR"
    chmod 700 "$RESOLVE_CACHE_DIR"
  fi

  local tool cache_file pids=()
  for tool in "${_tools_ref[@]}"; do
    test -f "$PREFIX/libexec/$tool/manifest.txt" || continue
    cache_file="$RESOLVE_CACHE_DIR/${tool}.latest"

    if _cache_is_valid "$cache_file"; then
      _cache_get "$cache_file" > "$RESOLVE_CACHE_DIR/${tool}.result"
      continue
    fi

    (
      version=$(timeout 20 bash "$INSTALL_SH" "$tool" --resolve-version 2>/dev/null || true)
      case "$version" in
        TARGET_VERSION=*) version="${version#TARGET_VERSION=}" ;;
        *) version="" ;;
      esac
      _cache_set "$cache_file" "$version"
      printf '%s' "$version" > "$RESOLVE_CACHE_DIR/${tool}.result"
    ) &
    pids+=("$!")
  done

  local p
  for p in "${pids[@]:-}"; do
    test -n "$p" && wait "$p" || true
  done

  _cleanup_resolve_cache
}

json_escape() {
  local s="$1" i ch hex
  local IFS=$' \t\n'
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  s=${s//$'\t'/\\t}
  for ((i = 1; i <= 31; i++)); do
    case "$i" in 9|10|13) continue ;; esac
    printf -v hex '%02x' "$i"
    printf -v ch '%b' "\\0$(printf '%03o' "$i")"
    s=${s//$ch/\\u00$hex}
  done
  printf -v ch '%b' '\177'
  s=${s//$ch/\\u007f}
  # Escape non-UTF-8 high bytes (0x80-0xff) as \u00xx for valid JSON output.
  for ((i = 128; i <= 255; i++)); do
    printf -v hex '%02x' "$i"
    printf -v ch '%b' "\\$(printf '%03o' "$i")"
    s=${s//$ch/\\u00$hex}
  done
  printf '%s' "$s"
}

cmd_list() {
  local offline=false json=false filter="" tool
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --offline) offline=true ;;
      --json) json=true ;;
      -h|--help) help_sub list; return 0 ;;
      --*) err "Unknown option for list: $1"; return 2 ;;
      *)
        [[ -z "$filter" ]] || { err "list accepts a single tool as filter."; return 2; }
        filter="$1" ;;
    esac
    shift
  done

  local f app display desc mf tag version installed_at installed update latest
  local rows=() row
  local names=() name
  # ASCII unit separator (0x1f) delimiter prevents collisions with config content.
  local USEP=$'\x1f'

  if [[ -n "$filter" ]]; then
    validate_tool "$filter"
    names=("$filter")
  else
    while IFS= read -r name; do [[ -n "$name" ]] && names+=("$name"); done < <(list_registry)
  fi
  [[ ${#names[@]} -gt 0 ]] || {
    err "No tools registered in $REGISTRY_DIR."
    return 1
  }

  if [[ "$offline" != true ]]; then
    resolve_all_latest names
  fi

  for tool in "${names[@]}"; do
    f="$REGISTRY_DIR/$tool.conf"
    app=$(conf_get "$f" APP_NAME)
    display=$(conf_get "$f" DISPLAY_NAME)
    desc=$(conf_get "$f" DESCRIPTION)
    mf="$PREFIX/libexec/$app/manifest.txt"
    installed="no"; version=""; installed_at=""; update=""; latest=""
    if [[ -f "$mf" ]]; then
      tag=$(manifest_get tag "$mf")
      version="${tag#v}"
      installed_at=$(manifest_get installed_at "$mf")
      installed="si"
      if [[ "$offline" != true ]]; then
        latest=$(cat "$RESOLVE_CACHE_DIR/${tool}.result" 2>/dev/null || true)
        if [[ -n "$latest" ]]; then
          if [[ -n "$version" && "$latest" == "$version" ]]; then
            update="no"
          else
            update="yes"
          fi
        else
          update="n/a"
        fi
      else
        update="n/a"
      fi
    else
      update="—"
    fi
    rows+=("$tool$USEP$display$USEP$desc$USEP$installed$USEP$version$USEP$installed_at$USEP$update$USEP$latest")
  done

  if [[ "$json" == true ]]; then
    print_json_rows "${rows[@]}"
    return 0
  fi

  local w=4 wv=7 n v
  for n in "${names[@]}"; do [[ ${#n} -gt $w ]] && w=${#n}; done
  for row in "${rows[@]}"; do
    IFS=$USEP read -r -a _pv <<< "$row"
    v="${_pv[4]:-}"
    [[ ${#v} -gt $wv ]] && wv=${#v}
  done
  printf '%-*s  %-9s  %-*s  %s\n' "$w" 'TOOL' 'STATUS' "$wv" 'VERSION' 'UPDATE'
  local parts
  for row in "${rows[@]}"; do
    IFS=$USEP read -r -a parts <<< "$row"
    local inst_disp upd_disp
    if [[ "${parts[3]:-}" == "si" ]]; then
      inst_disp="${GREEN}installed${NC}"
      upd_disp=$(update_display "${parts[6]:-}")
    else
      inst_disp="${MUTED}—${NC}"
      upd_disp="${MUTED}—${NC}"
    fi
    printf '%-*s  %-9s  %-*s  %s\n' "$w" "${parts[0]}" "$inst_disp" "$wv" "${parts[4]:-—}" "$upd_disp"
  done
  printf '\n%sUPDATE: %syes%s = newer version available · %sno%s = up to date · %sn/a%s = could not determine (network/offline)%s\n' \
    "$MUTED" "$ORANGE" "$NC" "$GREEN" "$NC" "$MUTED" "$NC" "$NC"
  return 0
}

update_display() {
  case "$1" in
    yes|sí) printf '%s%s%s' "$ORANGE" "$1" "$NC" ;;
    no) printf '%s%s%s' "$GREEN" "$1" "$NC" ;;
    *)  printf '%s' "$1" ;;
  esac
}

print_json_rows() {
  local row
  local parts items=() item
  for row in "$@"; do
    IFS=$'\x1f' read -r -a parts <<< "$row"
    local inst_bool upd_json latest_json version_json installed_at_json
    [[ "${parts[3]:-}" == "si" ]] && inst_bool=true || inst_bool=false
    case "${parts[6]:-}" in
      yes|sí) upd_json=true ;;
      no) upd_json=false ;;
      *)  upd_json=null ;;
    esac
    [[ -n "${parts[7]:-}" ]] && latest_json="\"$(json_escape "${parts[7]:-}")\"" || latest_json=null
    [[ -n "${parts[4]:-}" ]] && version_json="\"$(json_escape "${parts[4]:-}")\"" || version_json=null
    [[ -n "${parts[5]:-}" ]] && installed_at_json="\"$(json_escape "${parts[5]:-}")\"" || installed_at_json=null
    item=$(printf '{"name": "%s", "display_name": "%s", "description": "%s", "installed": %s, "version": %s, "installed_at": %s, "latest_version": %s, "update_available": %s}' \
      "$(json_escape "${parts[0]}")" "$(json_escape "${parts[1]}")" "$(json_escape "${parts[2]}")" \
      "$inst_bool" "$version_json" "$installed_at_json" "$latest_json" "$upd_json")
    items+=("$item")
  done
  printf '{\n  "tools": [\n'
  local i
  for (( i = 0; i < ${#items[@]}; i++ )); do
    printf '    %s' "${items[$i]}"
    [[ $i -lt $(( ${#items[@]} - 1 )) ]] && printf ','
    printf '\n'
  done
  printf '  ]\n}\n'
}

cmd_install() {
  [[ $# -ge 1 ]] || { err "Usage: aicli install <tool> [flags]"; err "Run 'aicli install --help' for available flags."; return 2; }
  [[ "$1" == "-h" || "$1" == "--help" ]] && { help_sub install; return 0; }
  case "$1" in
    -*)
      err "Tool name must come first: aicli install <tool> [-v X.Y.Z | --sha256 <hash> | --require-attestation]"
      err "Received: aicli install $*"
      return 2 ;;
  esac
  validate_tool "$1"
  exec bash "$INSTALL_SH" "$@"
}

cmd_update() {
  [[ $# -ge 1 ]] || { err "Usage: aicli update <tool> | aicli update --all"; return 2; }
  [[ "$1" == "-h" || "$1" == "--help" ]] && { help_sub update; return 0; }

  if [[ "$1" == "--all" ]]; then
    [[ $# -eq 1 ]] || {
      err "--all does not accept additional arguments."
      return 2
    }
    local tool failed=0 updated=0 skipped=0
    for tool in $(list_registry); do
      if [[ ! -f "$PREFIX/libexec/$tool/manifest.txt" ]]; then
        info "$tool: not installed — skipped"
        skipped=$((skipped + 1))
        continue
      fi
      printf '%s\n' "Updating $tool..."
      if bash "$INSTALL_SH" "$tool" --update; then
        updated=$((updated + 1))
      else
        err "$tool: update failed"
        failed=$((failed + 1))
      fi
    done
    if [[ $failed -gt 0 ]]; then
      err "Summary: $updated updated, $failed failed, $skipped skipped."
      return 1
    fi
    info "Summary: $updated updated, $failed failed, $skipped skipped."
    return 0
  fi

  validate_tool "$1"
  [[ $# -eq 1 ]] || {
    err "update does not accept flags. For a specific version: aicli install <tool> -v X.Y.Z"
    return 2
  }
  exec bash "$INSTALL_SH" "$1" --update
}

cmd_remove() {
  [[ $# -ge 1 ]] || { err "Usage: aicli remove <tool>"; return 2; }
  [[ "$1" == "-h" || "$1" == "--help" ]] && { help_sub remove; return 0; }
  validate_tool "$1"
  [[ $# -eq 1 ]] || { err "remove does not accept flags."; return 2; }
  exec bash "$INSTALL_SH" "$1" -u
}

cmd_verify() {
  [[ $# -ge 1 ]] || { err "Usage: aicli verify <tool>"; return 2; }
  [[ "$1" == "-h" || "$1" == "--help" ]] && { help_sub verify; return 0; }
  validate_tool "$1"
  [[ $# -eq 1 ]] || { err "verify does not accept flags."; return 2; }
  exec bash "$VERIFY_SH" "$1"
}

cmd_doctor() {
  local fails=0 warns=0
  pass() { printf '%sPASS%s: %s\n' "$GREEN" "$NC" "$1"; }
  fail() { printf '%sFAIL%s: %s\n' "$RED" "$NC" "$1"; fails=$((fails + 1)); }
  warn_() { printf '%sWARN%s: %s\n' "$ORANGE" "$NC" "$1"; warns=$((warns + 1)); }

  printf '=== aicli Diagnostics ===\n\n'

  if [[ -f "$INSTALL_SH" ]]; then
    pass "Repository: $REPO_DIR"
  else
    fail "Repository not found at $REPO_DIR (run from clone or set AI_CLI_TERMUX_DIR)"
  fi

  case "$(uname -m)" in
    aarch64|x86_64) pass "Architecture: $(uname -m)" ;;
    *) fail "Unsupported architecture: $(uname -m)" ;;
  esac

  local c missing=()
  for c in curl jq tar awk sha256sum; do
    command -v "$c" >/dev/null 2>&1 || missing+=("$c")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    fail "Missing dependencies: ${missing[*]} (pkg install curl jq gawk coreutils)"
  else
    pass "Installer dependencies present"
  fi

  local wrapper="$PREFIX/bin/aicli"
  if [[ -f "$wrapper" ]]; then
    if grep -qF "$AICLI_MARK" "$wrapper" 2>/dev/null; then
      pass "aicli wrapper installed: $wrapper"
    else
      fail "$wrapper exists without ownership mark '$AICLI_MARK' (foreign binary; left untouched)"
    fi
  elif [[ -L "$wrapper" ]]; then
    fail "Symlink $wrapper exists and is not the aicli wrapper (left untouched)"
  else
    warn_ "aicli wrapper not installed — run 'aicli self-install'"
  fi

  local loader=""
  case "$(uname -m)" in
    aarch64) loader="$PREFIX/glibc/lib/ld-linux-aarch64.so.1" ;;
    x86_64)  loader="$PREFIX/glibc/lib/ld-linux-x86-64.so.2" ;;
  esac
  if [[ -n "$loader" && -f "$loader" ]]; then
    pass "Glibc loader present"
  else
    warn_ "Glibc loader not found ($loader) — installed with CLIs (pkg install glibc-repo glibc-runner)"
  fi

  local t app mf tag
  for t in $(list_registry); do
    app=$(conf_get "$REGISTRY_DIR/$t.conf" APP_NAME)
    mf="$PREFIX/libexec/$app/manifest.txt"
    if [[ -f "$mf" ]]; then
      tag=$(manifest_get tag "$mf")
      pass "$t installed (${tag#v})"
    else
      printf '      %s-%s: %s not installed\n' "$MUTED" "$NC" "$t"
    fi
  done

  printf '\n=== Result: %d failures, %d warnings ===\n' "$fails" "$warns"
  [[ "$fails" -gt 0 ]] && return 1
  return 0
}

cmd_completion() {
  local shell="${1:-}"
  [[ -n "$shell" ]] || { err "Usage: aicli completion <bash|zsh|fish>"; return 2; }
  case "$shell" in
    bash) comp_bash ;;
    zsh) comp_zsh ;;
    fish) comp_fish ;;
    *) err "Unsupported shell: '$shell' (bash|zsh|fish)"; return 2 ;;
  esac
}

tools_spaced() {
  list_registry | paste -sd ' ' -
}

comp_bash() {
  local tools; tools=$(tools_spaced)
  cat <<EOF
# bash completion for aicli
_aicli() {
  local cur sub
  cur="\${COMP_WORDS[COMP_CWORD]}"
  sub="\${COMP_WORDS[1]}"
  case "\$COMP_CWORD" in
    1)
      COMPREPLY=( \$(compgen -W "$SUBCOMMANDS $tools --version --help --no-color" -- "\$cur") )
      ;;
    2)
      case "\$sub" in
        install|remove|verify|list)
          COMPREPLY=( \$(compgen -W "$tools" -- "\$cur") )
          ;;
        update)
          COMPREPLY=( \$(compgen -W "$tools --all" -- "\$cur") )
          ;;
        completion)
          COMPREPLY=( \$(compgen -W "bash zsh fish" -- "\$cur") )
          ;;
      esac
      ;;
  esac
}
complete -F _aicli aicli
EOF
}

comp_zsh() {
  local tools; tools=$(tools_spaced)
  cat <<EOF
#compdef aicli
_aicli() {
  if (( CURRENT == 2 )); then
    compadd $SUBCOMMANDS $tools --version --help --no-color
  elif (( CURRENT == 3 )); then
    case "\$words[2]" in
      install|remove|verify|list) compadd $tools ;;
      update) compadd $tools --all ;;
      completion) compadd bash zsh fish ;;
    esac
  fi
}
compdef _aicli aicli
EOF
}

comp_fish() {
  local tools; tools=$(tools_spaced)
  cat <<EOF
# fish completion for aicli
complete -c aicli -f -a "$SUBCOMMANDS $tools --version --help --no-color" -d 'aicli: AI CLI manager'
for t in install update remove verify list
  complete -c aicli -n "__fish_seen_subcommand_from \$t" -f -a "$tools" -d 'AI CLI'
end
complete -c aicli -n "__fish_seen_subcommand_from update" -f -a "--all" -d 'Update all installed CLIs'
complete -c aicli -n "__fish_seen_subcommand_from completion" -f -a "bash zsh fish"
EOF
}

write_wrapper() {
  local wrapper="$PREFIX/bin/aicli"
  if ! mkdir -p "$(dirname "$wrapper")"; then
    err "Could not create $(dirname "$wrapper") (permissions?)."
    return 1
  fi
  if [[ -e "$wrapper" || -L "$wrapper" ]] && ! grep -qF "$AICLI_MARK" "$wrapper" 2>/dev/null; then
    err "$wrapper already exists and is not the aicli wrapper (missing mark '$AICLI_MARK')."
    err "Fail-closed: will not overwrite existing binary."
    return 1
  fi
  local bad
  for bad in '"' "'" '$' '`' $'\\'; do
    if printf '%s' "$REPO_DIR" | grep -qF "$bad"; then
      err "Invalid repository path to embed in wrapper: $REPO_DIR"
      return 1
    fi
  done
  # Match newline via case pattern; grep -F with \n is treated as multiple empty patterns.
  case "$REPO_DIR" in
    *$'\n'*)
      err "Invalid repository path to embed in wrapper: $REPO_DIR"
      return 1
      ;;
  esac
  if ! cat > "$wrapper" <<EOF
#!/data/data/com.termux/files/usr/bin/bash
# $AICLI_MARK
# Generated wrapper for ai-cli-termux. Do not edit: regenerated by aicli self-install.
set -euo pipefail
exec "$REPO_DIR/aicli" "\$@"
EOF
  then
    err "Could not write $wrapper (disk full or permissions?)."
    return 1
  fi
  if ! chmod 755 "$wrapper"; then
    err "Could not set execution permissions on $wrapper."
    return 1
  fi
}

cmd_self_install() {
  if write_wrapper; then
    info "aicli installed: $PREFIX/bin/aicli -> $REPO_DIR/aicli"
    info "Available globally from any directory. To update the manager: aicli self-update"
  else
    return 1
  fi
}

cmd_self_update() {
  local wrapper="$PREFIX/bin/aicli"
  if [[ ! -e "$wrapper" && ! -L "$wrapper" ]]; then
    err "aicli is not installed at $PREFIX/bin/aicli."
    err "Run 'aicli self-install' (or from clone: bash aicli self-install)."
    return 1
  fi
  if ! grep -qF "$AICLI_MARK" "$wrapper" 2>/dev/null; then
    err "$wrapper is not the aicli wrapper (missing mark '$AICLI_MARK')."
    err "Fail-closed: will not overwrite existing binary."
    return 1
  fi
  if write_wrapper; then
    info "aicli updated: $PREFIX/bin/aicli -> $REPO_DIR/aicli"
  else
    return 1
  fi
}

suggest_cmd() {
  local guess="" c
  for c in $SUBCOMMANDS; do
    [[ "$c" == "$1"* ]] && guess="$c" && break
  done
  [[ -n "$guess" ]] && err "Did you mean '$guess'?"
}

main() {
  [[ "${1:-}" == "--no-color" ]] && { NO_COLOR=1; shift; }
  if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-}" != dumb ]]; then
    MUTED=$'\033[0;2m'; GREEN=$'\033[0;32m'; RED=$'\033[0;31m'
    ORANGE=$'\033[38;5;214m'; NC=$'\033[0m'
  fi

  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    "") usage_short; return 2 ;;
    -h|--help) usage; return 0 ;;
    --version) printf 'aicli %s\n' "$AICLI_VERSION"; return 0 ;;
  esac

  check_repo

  case "$cmd" in
    help) cmd_help "$@" ;;
    list) cmd_list "$@" ;;
    install) cmd_install "$@" ;;
    update|upgrade) cmd_update "$@" ;;
    remove|uninstall) cmd_remove "$@" ;;
    verify) cmd_verify "$@" ;;
    doctor) cmd_doctor ;;
    completion) cmd_completion "$@" ;;
    self-install) cmd_self_install ;;
    self-update) cmd_self_update ;;
    *)
      err "Unknown subcommand: '$cmd'"
      err "Run 'aicli help' for the complete list."
      suggest_cmd "$cmd"
      return 2 ;;
  esac
}

main "$@"
